# ==============================================================================
# CyberQuant AI — Environment Configuration Template (.env.example)
# Copy this file to .env for local development.
# DO NOT COMMIT ACTUAL SECRETS OR REAL CREDENTIALS.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="CyberQuant AI"
API_V1_STR=/api/v1
MOCK_DATA_PATH=./mock_data.json

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cyberquant_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberquant_db

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Neo4j Database Configuration (Member 2 Integration)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cyberquant_secure_pass

# Security & JWT Configuration
JWT_SECRET_KEY=cyberquant_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
